<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="OfflineMaps.App.RegionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:OfflineMaps.App"
    Title="Regions - Offline US Maps">

    <!--  Collection workspace (standard section 7): the regions on the left with their filter
          above, the selected region's details and commands in the pane on the right.  -->
    <Grid x:Name="Root" Background="{ThemeResource JupiterWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" MinWidth="{StaticResource JupiterPaneMinWidth}" />
            </Grid.ColumnDefinitions>

            <Grid Padding="16" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <AutoSuggestBox
                    x:Name="FilterBox"
                    AutomationProperties.Name="Filter regions"
                    PlaceholderText="Filter regions"
                    QueryIcon="Find"
                    TextChanged="FilterBox_TextChanged" />
                <ListView
                    x:Name="RegionList"
                    Grid.Row="1"
                    AutomationProperties.Name="Regions"
                    SelectionChanged="RegionList_SelectionChanged"
                    SelectionMode="Single">
                    <!--  One group per country: United States, Canada, Mexico  -->
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="local:RegionGroup">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource JupiterCaptionStrongTextStyle}"
                                        Text="{x:Bind Key}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:RegionItem">
                            <StackPanel Padding="0,8" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" Spacing="4">
                                <TextBlock Style="{StaticResource JupiterBodyTextStyle}" Text="{x:Bind Name}" />
                                <TextBlock
                                    Style="{StaticResource JupiterCaptionTextStyle}"
                                    Text="{x:Bind Caption, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <controls:GridSplitter
                Grid.Column="1"
                Width="8"
                AutomationProperties.Name="Resize details pane"
                Background="{ThemeResource JupiterWindowBrush}"
                ResizeBehavior="BasedOnAlignment"
                ResizeDirection="Columns" />

            <ScrollViewer Grid.Column="2" Background="{ThemeResource JupiterSurfaceBrush}">
                <StackPanel Padding="{StaticResource JupiterPanePadding}" Spacing="16">
                    <TextBlock
                        x:Name="DetailHeading"
                        Style="{StaticResource JupiterPaneHeadingTextStyle}"
                        Text="Region" />
                    <TextBlock
                        x:Name="DetailText"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource JupiterBodyTextStyle}"
                        Text="Choose a region to download it, check it for updates or remove it."
                        TextWrapping="Wrap" />
                    <StackPanel x:Name="Commands" Spacing="8">
                        <Button
                            x:Name="CheckButton"
                            HorizontalAlignment="Stretch"
                            Click="CheckButton_Click"
                            Content="Check for updates" />
                        <Button
                            x:Name="MapButton"
                            HorizontalAlignment="Stretch"
                            Click="MapButton_Click"
                            Content="Download map"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="ExtrasButton"
                            HorizontalAlignment="Stretch"
                            Click="ExtrasButton_Click"
                            Content="Download stations and addresses" />
                        <Button
                            x:Name="OverlaysButton"
                            HorizontalAlignment="Stretch"
                            Click="OverlaysButton_Click"
                            Content="Download flood zones and public lands" />
                        <Button
                            x:Name="TerrainButton"
                            HorizontalAlignment="Stretch"
                            Click="TerrainButton_Click"
                            Content="Download terrain" />
                        <Button
                            x:Name="RemoveButton"
                            HorizontalAlignment="Stretch"
                            Click="RemoveButton_Click"
                            Content="Remove…" />
                    </StackPanel>
                    <TextBlock
                        x:Name="SourceText"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource JupiterCaptionTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--  Status bar (standard section 6): persistent state only  -->
        <Border Grid.Row="1" Style="{StaticResource JupiterStatusBarStyle}">
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource JupiterCaptionTextStyle}"
                TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
